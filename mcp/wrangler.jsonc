{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "philly-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../website/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp", "/mcp/*"],
    "not_found_handling": "404-page",
  },
  "vars": { "PUBLIC_ORIGIN": "http://127.0.0.1:8787" },
  "observability": { "enabled": false },
  "env": {
    "production": {
      "name": "philly-mcp",
      "account_id": "ad42ca6462e685e4e4da043973e3781a",
      "vars": { "PUBLIC_ORIGIN": "https://philly.horv.co" },
    },
  },
}
