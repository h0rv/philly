---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExplorationCard from '../../components/ExplorationCard.astro';
import explorations from '../../data/explorations.generated.json';

const liveExplorations = explorations.filter((item) => item.ready);
---

<BaseLayout
  title="Philly explorations"
  description="Explorations built with the Philly library."
>
  <section>
    <h1>Explorations</h1>
    <p class="lede">Published interactive work from this repo.</p>
    <p>
      The homepage now opens directly into <strong>City Atlas</strong>. Everything else lives here.
    </p>
  </section>

  <section>
    <h2>Available</h2>
    <div class="grid two-col">
      {liveExplorations.map((exploration) => <ExplorationCard exploration={exploration} />)}
    </div>
  </section>
</BaseLayout>
