---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wordmark from '../components/Wordmark.astro';
import Install from '../components/Install.astro';
import catalog from '../data/catalog.generated.json';
---
<BaseLayout>
  <h1><Wordmark /></h1>
  <p>{catalog.datasets} Philadelphia datasets. CLI, Python, MCP.</p>
  <Install />
  <p><a href={`${import.meta.env.BASE_URL}connect/`}>Connect an MCP client</a></p>
</BaseLayout>
