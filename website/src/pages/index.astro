---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wordmark from '../components/Wordmark.astro';
import Install from '../components/Install.astro';
import catalog from '../data/catalog.generated.json';
---
<BaseLayout>
  <h1><Wordmark /></h1>
  <p>Search {catalog.datasets} Philadelphia datasets from your terminal, Python, or MCP client.</p>
  <Install />
  <p><a href={`${import.meta.env.BASE_URL}connect/`}>Client setup</a></p>
</BaseLayout>
