---
const base = import.meta.env.BASE_URL;
const withBase = (value) => `${base}${String(value).replace(/^\//, '')}`;

const title = 'City Atlas | Philly';
const description =
  'A full-screen timelapse of Philadelphia across atlas plates and aerial imagery from 1860 through 2025.';
const serviceWorkerUrl = withBase('/sw.js');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0d0d" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@5.21.1/dist/maplibre-gl.css" />
    <script is:inline src="https://unpkg.com/maplibre-gl@5.21.1/dist/maplibre-gl.js"></script>
    <style>
      :root {
        color-scheme: dark;
      }

      *, *::before, *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background: #0d0d0d;
        color: #fff;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        overflow: hidden;
        height: 100dvh;
        width: 100dvw;
      }

      a {
        color: inherit;
      }

      button {
        font: inherit;
      }

      #map {
        position: absolute;
        inset: 0;
      }

      #wordmark {
        position: absolute;
        top: 24px;
        right: 28px;
        z-index: 10;
        text-align: right;
        pointer-events: none;
        user-select: none;
      }

      #wordmark-title {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 36px;
        letter-spacing: 0.06em;
        line-height: 1;
        color: #fff;
        text-shadow: 0 2px 20px rgba(0, 0, 0, 0.9);
      }

      #wordmark-sub {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.42);
        margin-top: 5px;
        text-shadow: 0 1px 8px rgba(0, 0, 0, 0.9);
      }

      #utility-actions {
        position: absolute;
        top: 90px;
        right: 28px;
        z-index: 11;
        display: flex;
        gap: 10px;
        justify-content: flex-end;
      }

      .ghost-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 36px;
        padding: 0 12px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        background: rgba(12, 15, 22, 0.56);
        color: rgba(255, 255, 255, 0.86);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        cursor: pointer;
        backdrop-filter: blur(16px);
        transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
      }

      .ghost-button:hover,
      .ghost-button:focus-visible {
        background: rgba(255, 255, 255, 0.14);
        border-color: rgba(255, 255, 255, 0.34);
        transform: translateY(-1px);
      }

      #hud {
        position: absolute;
        top: 24px;
        left: 28px;
        z-index: 10;
        pointer-events: none;
        user-select: none;
      }

      #year-number {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 110px;
        letter-spacing: 0.02em;
        line-height: 0.88;
        color: #fff;
        text-shadow: 0 2px 48px rgba(0, 0, 0, 0.95);
        display: block;
        transition: opacity 0.16s ease, transform 0.16s ease;
      }

      #year-number.exit {
        opacity: 0;
        transform: translateY(-16px);
      }

      #snapshot-label {
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.45);
        margin-top: 10px;
        text-shadow: 0 1px 10px rgba(0, 0, 0, 0.95);
        transition: opacity 0.2s ease;
      }

      #era-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-top: 9px;
        padding: 3px 9px 3px 7px;
        border-radius: 3px;
        font-size: 9.5px;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        border: 1px solid currentColor;
        opacity: 0.65;
        transition: color 0.4s ease, border-color 0.4s ease;
      }

      #era-badge::before {
        content: '';
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: currentColor;
        flex-shrink: 0;
      }

      #coverage-warn {
        display: none;
        margin-top: 10px;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.08em;
        color: rgba(255, 200, 100, 0.72);
        text-shadow: 0 1px 8px rgba(0, 0, 0, 0.9);
      }

      #coverage-warn.show {
        display: block;
      }

      #intro-card {
        position: absolute;
        right: 32px;
        bottom: 124px;
        z-index: 10;
        width: min(360px, calc(100vw - 64px));
        padding: 18px 18px 16px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 20px;
        background:
          linear-gradient(180deg, rgba(23, 30, 42, 0.86), rgba(8, 10, 14, 0.72));
        backdrop-filter: blur(18px);
        box-shadow: 0 18px 54px rgba(0, 0, 0, 0.32);
        transition: opacity 0.28s ease, transform 0.28s ease;
      }

      #intro-card.is-hidden {
        opacity: 0;
        transform: translateY(12px);
        pointer-events: none;
      }

      #help-panel {
        position: absolute;
        top: 138px;
        right: 32px;
        z-index: 11;
        width: min(420px, calc(100vw - 64px));
        max-height: min(70dvh, 620px);
        overflow: auto;
        padding: 18px 18px 16px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 20px;
        background:
          linear-gradient(180deg, rgba(18, 23, 33, 0.94), rgba(8, 10, 14, 0.9));
        backdrop-filter: blur(18px);
        box-shadow: 0 18px 54px rgba(0, 0, 0, 0.36);
        opacity: 0;
        transform: translateY(-8px);
        pointer-events: none;
        transition: opacity 0.2s ease, transform 0.2s ease;
      }

      #help-panel.is-open {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
      }

      #help-panel h2 {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 34px;
        letter-spacing: 0.04em;
        line-height: 0.95;
        margin-bottom: 12px;
      }

      #help-panel p,
      #help-panel li {
        color: rgba(255, 255, 255, 0.78);
        font-size: 13.5px;
        line-height: 1.55;
      }

      #help-panel section + section {
        margin-top: 14px;
      }

      #help-panel ul {
        list-style: none;
        display: grid;
        gap: 8px;
      }

      .help-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 4px;
      }

      .help-close {
        width: 34px;
        height: 34px;
        flex-shrink: 0;
        border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, 0.16);
        background: rgba(255, 255, 255, 0.05);
        color: rgba(255, 255, 255, 0.82);
        cursor: pointer;
      }

      .help-close:hover,
      .help-close:focus-visible {
        background: rgba(255, 255, 255, 0.12);
      }

      .help-label {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.48);
        margin-bottom: 8px;
      }

      .help-note {
        color: rgba(255, 255, 255, 0.62);
      }

      .help-links {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 14px;
      }

      .help-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 34px;
        padding: 0 12px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        background: rgba(255, 255, 255, 0.04);
        color: rgba(255, 255, 255, 0.88);
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .help-link:hover,
      .help-link:focus-visible {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.28);
      }

      #intro-card p {
        color: rgba(255, 255, 255, 0.74);
        font-size: 14px;
        line-height: 1.55;
      }

      .eyebrow {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.54);
        margin-bottom: 10px;
      }

      #intro-card h1 {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 42px;
        letter-spacing: 0.04em;
        line-height: 0.96;
        margin-bottom: 12px;
      }

      #intro-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 16px;
      }

      .card-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 14px;
        border-radius: 999px;
        text-decoration: none;
        border: 1px solid rgba(255, 255, 255, 0.16);
        transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
      }

      .card-button {
        background: #f1f2f4;
        color: #101214;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        cursor: pointer;
      }

      .card-button:hover,
      .card-button:focus-visible {
        transform: translateY(-1px);
        background: #ffffff;
      }

      #bottom {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 10;
        padding: 0 32px 28px;
        background: linear-gradient(
          to top,
          rgba(0, 0, 0, 0.9) 0%,
          rgba(0, 0, 0, 0.55) 50%,
          transparent 100%
        );
      }

      #controls {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
      }

      #play-btn {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: 1.5px solid rgba(255, 255, 255, 0.22);
        background: rgba(255, 255, 255, 0.07);
        color: #fff;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        outline: none;
        transition: background 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
        flex-shrink: 0;
      }

      #play-btn:hover {
        background: rgba(255, 255, 255, 0.16);
        border-color: rgba(255, 255, 255, 0.4);
      }

      #play-btn:active {
        transform: scale(0.9);
      }

      #speed-controls {
        display: flex;
        gap: 2px;
      }

      .speed-btn {
        padding: 4px 8px;
        border-radius: 3px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: transparent;
        color: rgba(255, 255, 255, 0.3);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.05em;
        cursor: pointer;
        outline: none;
        transition: all 0.15s ease;
      }

      .speed-btn:hover {
        color: rgba(255, 255, 255, 0.65);
        border-color: rgba(255, 255, 255, 0.28);
      }

      .speed-btn.active {
        color: #fff;
        border-color: rgba(255, 255, 255, 0.45);
        background: rgba(255, 255, 255, 0.1);
      }

      #hint {
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.32);
        letter-spacing: 0.05em;
        margin-left: 2px;
      }

      #timeline {
        position: relative;
        height: 64px;
      }

      #track-bg {
        position: absolute;
        top: 15px;
        left: 0;
        right: 0;
        height: 1px;
        background: rgba(255, 255, 255, 0.1);
      }

      #track-fill {
        position: absolute;
        top: 15px;
        left: 0;
        height: 1px;
        background: rgba(255, 255, 255, 0.55);
        pointer-events: none;
        transition: width 0.32s cubic-bezier(0.4, 0, 0.2, 1);
      }

      :global(.tick) {
        position: absolute;
        top: 8px;
        transform: translateX(-50%);
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      :global(.dot) {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.22);
        border: 1px solid rgba(255, 255, 255, 0.32);
        transition:
          transform 0.15s ease,
          background 0.15s ease,
          box-shadow 0.15s ease,
          width 0.15s ease,
          height 0.15s ease;
        flex-shrink: 0;
      }

      :global(.tick:hover .dot) {
        background: rgba(255, 255, 255, 0.6);
        transform: scale(1.7);
      }

      :global(.tick.active .dot) {
        width: 10px;
        height: 10px;
        background: #fff;
        border-color: #fff;
        box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.14), 0 0 20px rgba(255, 255, 255, 0.25);
        transform: none;
      }

      :global(.tick-lbl) {
        font-size: 9.5px;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.25);
        letter-spacing: 0.02em;
        white-space: nowrap;
        line-height: 1;
        margin-top: 10px;
        transform: translate(var(--label-shift, 0px), var(--lane-offset, 0px));
        transition: color 0.15s ease;
      }

      :global(.tick:hover .tick-lbl),
      :global(.tick.active .tick-lbl) {
        color: rgba(255, 255, 255, 0.82);
      }

      :global(.tick-lbl.hide) {
        visibility: hidden;
      }

      #era-row {
        position: absolute;
        top: 46px;
        left: 0;
        right: 0;
        pointer-events: none;
      }

      :global(.era-tag) {
        position: absolute;
        transform: translateX(-50%);
        font-size: 8px;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.14);
        white-space: nowrap;
      }

      :global(.maplibregl-ctrl-bottom-right) {
        bottom: 122px !important;
        right: 12px !important;
      }

      :global(.maplibregl-ctrl-attrib) {
        background: rgba(0, 0, 0, 0.4) !important;
      }

      :global(.maplibregl-ctrl-attrib-inner),
      :global(.maplibregl-ctrl-attrib a) {
        color: rgba(255, 255, 255, 0.35) !important;
        font-size: 10px !important;
      }

      @media (max-width: 900px) {
        #intro-card {
          right: 24px;
          bottom: 132px;
          width: min(320px, calc(100vw - 48px));
        }

        #wordmark-title {
          font-size: 32px;
        }

        #year-number {
          font-size: 92px;
        }
      }

      @media (max-width: 720px) {
        #wordmark {
          right: 20px;
        }

        #utility-actions {
          top: 82px;
          right: 20px;
        }

        #hud {
          top: 20px;
          left: 20px;
        }

        #year-number {
          font-size: 76px;
        }

        #intro-card {
          left: 20px;
          right: 20px;
          bottom: 146px;
          width: auto;
          padding: 16px;
        }

        #intro-card h1 {
          font-size: 34px;
        }

        #bottom {
          padding: 0 20px 24px;
        }

        #controls {
          flex-wrap: wrap;
          gap: 10px;
          margin-bottom: 14px;
        }

        #hint {
          width: 100%;
          margin-left: 0;
        }

        :global(.maplibregl-ctrl-bottom-right) {
          bottom: 132px !important;
        }
      }

      @media (max-width: 540px) {
        #wordmark {
          top: 16px;
        }

        #wordmark-title {
          font-size: 24px;
        }

        #wordmark-sub {
          font-size: 9px;
        }

        #hud {
          top: 64px;
        }

        #year-number {
          font-size: 62px;
        }

        #snapshot-label {
          font-size: 10px;
        }

        #intro-card {
          bottom: 148px;
        }

        #intro-card p {
          font-size: 13px;
        }

        #help-panel {
          top: auto;
          left: 20px;
          right: 20px;
          bottom: 156px;
          width: auto;
          max-height: min(56dvh, 520px);
        }

        #timeline {
          height: 56px;
        }

        :global(.tick-lbl) {
          font-size: 8.5px;
        }

        :global(.era-tag) {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <div id="map"></div>

    <div id="wordmark">
      <div id="wordmark-title">City Atlas</div>
      <div id="wordmark-sub">Philly 1860-2025</div>
    </div>

    <div id="utility-actions">
      <button class="ghost-button" id="help-toggle-btn" type="button">About The Data</button>
      <a class="ghost-button" href="https://github.com/h0rv/philly" target="_blank" rel="noreferrer">GitHub</a>
    </div>

    <div id="hud">
      <span id="year-number">2025</span>
      <div id="snapshot-label">Aerial Photography - 3-inch</div>
      <div id="era-badge">Modern Aerial</div>
      <div id="coverage-warn">Coverage for this survey year is incomplete.</div>
    </div>

    <aside id="help-panel" aria-hidden="true">
      <div class="help-head">
        <div>
          <div class="help-label">How to read this</div>
          <h2>What This Map Is Showing</h2>
        </div>
        <button class="help-close" id="help-close-btn" type="button" aria-label="Close help panel">×</button>
      </div>

      <section>
        <p>
          One fixed camera. Many basemaps. The timeline swaps between hand-drawn atlases, land-use surveys, and modern
          aerial imagery so you can watch Philadelphia change in place.
        </p>
      </section>

      <section>
        <div class="help-label">Resolution</div>
        <ul>
          <li><strong>1-inch / 2-inch / 3-inch / 6-inch</strong> means ground resolution per pixel.</li>
          <li><strong>1-inch</strong> is sharper than <strong>6-inch</strong> because each pixel covers less area on the ground.</li>
          <li class="help-note">These are map-imagery resolution labels, not print sizes.</li>
        </ul>
      </section>

      <section>
        <div class="help-label">What The Years Represent</div>
        <ul>
          <li><strong>1860–1910</strong>: hand-drawn city atlases.</li>
          <li><strong>1928–1975</strong>: early aerial and land-use survey layers.</li>
          <li><strong>1996–2025</strong>: modern aerial orthophotography.</li>
        </ul>
      </section>

      <section>
        <div class="help-label">Acknowledgements</div>
        <ul>
          <li>Imagery and historical map layers come from the City of Philadelphia GIS imagery archive and related public map services.</li>
          <li>Open data context and dataset discovery in this repo are supported by <strong>OpenDataPhilly</strong>.</li>
          <li>Built with <strong>philly</strong>, aided by the tool’s data exploration capabilities.</li>
        </ul>
        <div class="help-links">
          <a class="help-link" href="https://github.com/h0rv/philly" target="_blank" rel="noreferrer">GitHub Repo</a>
          <a class="help-link" href="https://opendataphilly.org" target="_blank" rel="noreferrer">OpenDataPhilly</a>
        </div>
      </section>
    </aside>

    <aside id="intro-card">
      <div class="eyebrow">Featured exploration</div>
      <h1>Philadelphia through 165 years of maps.</h1>
      <p>
        Scrub from atlas plates to aerial surveys, keep the same camera position, and watch neighborhoods, highways,
        and shorelines appear in place.
      </p>
      <div id="intro-actions">
        <button class="card-button" id="jump-start-btn" type="button">Start at 1860</button>
      </div>
    </aside>

    <div id="bottom">
      <div id="controls">
        <button id="play-btn" type="button" title="Play (Space)">&gt;</button>
        <div id="speed-controls">
          <button class="speed-btn" data-speed="2600" type="button">1/2x</button>
          <button class="speed-btn active" data-speed="1400" type="button">1x</button>
          <button class="speed-btn" data-speed="700" type="button">2x</button>
          <button class="speed-btn" data-speed="280" type="button">4x</button>
        </div>
        <span id="hint">Use left/right to step, space to play, and home/end to jump.</span>
      </div>

      <div id="timeline">
        <div id="track-bg"></div>
        <div id="track-fill"></div>
        <div id="era-row"></div>
      </div>
    </div>

    <script is:inline define:vars={{ serviceWorkerUrl }}>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register(serviceWorkerUrl).catch(() => {});
      }

      const tileRoot = 'https://tiles.arcgis.com/tiles/fLeGjb7u4uXqeF9q/arcgis/rest/services';

      const snapshots = [
        { year: 1860, era: 'City Atlas', label: 'Hexamer Locher City Atlas', maxzoom: 18, gaps: false, svc: 'HistoricHexamerLocherAtlas_1860' },
        { year: 1875, era: 'City Atlas', label: 'GM Hopkins City Atlas', maxzoom: 18, gaps: false, svc: 'HistoricGMHopkinsAtlas_1875' },
        { year: 1895, era: 'City Atlas', label: 'Bromley City Atlas', maxzoom: 18, gaps: false, svc: 'HistoricBromleyAtlas_1895' },
        { year: 1910, era: 'City Atlas', label: 'Bromley City Atlas', maxzoom: 18, gaps: false, svc: 'HistoricBromleyAtlas_1910' },
        { year: 1928, era: 'Early Aerial', label: 'Historical Aerial Survey', maxzoom: 18, gaps: false, svc: 'CityImagery_1928_RPF' },
        { year: 1942, era: 'Early Aerial', label: 'WPA Land Use Survey', maxzoom: 18, gaps: false, svc: 'HistoricLandUse_1942' },
        { year: 1959, era: 'Early Aerial', label: 'DVRPC Aerial Survey', maxzoom: 17, gaps: true, svc: 'CityImagery_1959_DVRPC' },
        { year: 1962, era: 'Early Aerial', label: 'WPA Land Use Survey', maxzoom: 18, gaps: false, svc: 'HistoricLandUse_1962' },
        { year: 1975, era: 'Early Aerial', label: 'DVRPC Aerial Survey', maxzoom: 17, gaps: true, svc: 'CityImagery_1975_DVRPC' },
        { year: 1996, era: 'Modern Aerial', label: 'Aerial Photography - 6-inch', maxzoom: 20, gaps: false, svc: 'CityImagery_1996_6in' },
        { year: 1999, era: 'Modern Aerial', label: 'USGS Aerial Survey', maxzoom: 19, gaps: false, svc: 'CityImagery_1999_USGS' },
        { year: 2000, era: 'Modern Aerial', label: 'Aerial Photography - 18-inch', maxzoom: 19, gaps: false, svc: 'CityImagery_2000_18in' },
        { year: 2004, era: 'Modern Aerial', label: 'Aerial Photography - 6-inch', maxzoom: 20, gaps: false, svc: 'CityImagery_2004_6in' },
        { year: 2005, era: 'Modern Aerial', label: 'Aerial Photography - 16-inch', maxzoom: 19, gaps: false, svc: 'CityImagery_2005_16in' },
        { year: 2008, era: 'Modern Aerial', label: 'Aerial Photography - 3-inch', maxzoom: 21, gaps: false, svc: 'CityImagery_2008_3in' },
        { year: 2009, era: 'Modern Aerial', label: 'Aerial Photography - 6-inch', maxzoom: 20, gaps: false, svc: 'CityImagery_2009_6in' },
        { year: 2010, era: 'Modern Aerial', label: 'Aerial Photography - 3-inch', maxzoom: 21, gaps: false, svc: 'CityImagery_2010_3in' },
        { year: 2011, era: 'Modern Aerial', label: 'Aerial Photography - 12-inch', maxzoom: 20, gaps: false, svc: 'CityImagery_2011_12in_LEAFON' },
        { year: 2012, era: 'Modern Aerial', label: 'Aerial Photography - 3-inch', maxzoom: 21, gaps: false, svc: 'CityImagery_2012_3in' },
        { year: 2014, era: 'Modern Aerial', label: 'Aerial Photography - 6-inch', maxzoom: 20, gaps: false, svc: 'CityImagery_2014_6in' },
        { year: 2015, era: 'Modern Aerial', label: 'Aerial Photography - 3-inch', maxzoom: 21, gaps: false, svc: 'CityImagery_2015_3in' },
        { year: 2016, era: 'Modern Aerial', label: 'Aerial Photography - 3-inch', maxzoom: 21, gaps: false, svc: 'CityImagery_2016_3in' },
        { year: 2017, era: 'Modern Aerial', label: 'Aerial Photography - 3-inch', maxzoom: 21, gaps: false, svc: 'CityImagery_2017_3in' },
        { year: 2018, era: 'Modern Aerial', label: 'Aerial Photography - 3-inch', maxzoom: 21, gaps: false, svc: 'CityImagery_2018_3in' },
        { year: 2019, era: 'Modern Aerial', label: 'Aerial Photography - 3-inch', maxzoom: 21, gaps: false, svc: 'CityImagery_2019_3in' },
        { year: 2020, era: 'Modern Aerial', label: 'Aerial Photography - 3-inch', maxzoom: 21, gaps: false, svc: 'CityImagery_2020_3in' },
        { year: 2022, era: 'Modern Aerial', label: 'Aerial Photography - 2-inch', maxzoom: 21, gaps: false, svc: 'CityImagery_2022_2in' },
        { year: 2023, era: 'Modern Aerial', label: 'Aerial Photography - 2-inch', maxzoom: 21, gaps: false, svc: 'CityImagery_2023' },
        { year: 2024, era: 'Modern Aerial', label: 'Aerial Photography - 1-inch', maxzoom: 21, gaps: false, svc: 'CityImagery_2024_1in' },
        { year: 2025, era: 'Modern Aerial', label: 'Aerial Photography - 3-inch', maxzoom: 21, gaps: false, svc: 'CityImagery_2025_3in' },
      ].map((snapshot) => ({ ...snapshot, url: `${tileRoot}/${snapshot.svc}/MapServer/tile/{z}/{y}/{x}` }));

      const eraColors = {
        'City Atlas': '#d4a855',
        'Early Aerial': '#7fa8cc',
        'Modern Aerial': '#e0e0e0',
      };

      const minYear = snapshots[0].year;
      const maxYear = snapshots[snapshots.length - 1].year;
      const span = maxYear - minYear;
      const prefetchWindow = 2;

      const pct = (year) => `${(((year - minYear) / span) * 100).toFixed(3)}%`;
      const sourceId = (index) => `src-${index}`;
      const layerId = (index) => `lyr-${index}`;

      const map = new maplibregl.Map({
        container: 'map',
        style: {
          version: 8,
          sources: {},
          layers: [{ id: 'bg', type: 'background', paint: { 'background-color': '#181818' } }],
        },
        center: [-75.1652, 39.9526],
        zoom: 12,
        minZoom: 9,
        maxZoom: 21,
        hash: true,
        keyboard: false,
      });

      map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'bottom-right');

      let currentIndex = snapshots.length - 1;
      let playing = false;
      let playTimer = null;
      let playSpeed = 1400;

      const yearEl = document.getElementById('year-number');
      const labelEl = document.getElementById('snapshot-label');
      const badgeEl = document.getElementById('era-badge');
      const warnEl = document.getElementById('coverage-warn');
      const timelineEl = document.getElementById('timeline');
      const trackFillEl = document.getElementById('track-fill');
      const playBtn = document.getElementById('play-btn');
      const jumpStartBtn = document.getElementById('jump-start-btn');
      const introCardEl = document.getElementById('intro-card');
      const helpToggleBtn = document.getElementById('help-toggle-btn');
      const helpCloseBtn = document.getElementById('help-close-btn');
      const helpPanelEl = document.getElementById('help-panel');
      const labelEntries = [];

      function dismissIntro() {
        introCardEl?.classList.add('is-hidden');
      }

      function setHelpOpen(isOpen) {
        helpPanelEl?.classList.toggle('is-open', isOpen);
        helpPanelEl?.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
      }

      function layoutTimelineLabels() {
        const timelineWidth = timelineEl.clientWidth;
        if (!timelineWidth) {
          return;
        }

        let minGap = 18;
        if (window.innerWidth <= 540) {
          minGap = 8;
        } else if (window.innerWidth <= 900) {
          minGap = 12;
        }

        let previousRight = -Infinity;

        labelEntries.forEach(({ label, year }, index) => {
          label.classList.remove('hide');
          label.style.setProperty('--label-shift', '0px');
          label.style.setProperty('--lane-offset', '0px');

          const position = ((year - minYear) / span) * timelineWidth;
          let shift = 0;
          const halfWidth = label.offsetWidth / 2;

          if (index === 0) {
            shift = Math.max(16, halfWidth);
          } else if (index === snapshots.length - 1) {
            shift = -Math.max(16, halfWidth);
          }

          let left = position - halfWidth + shift;
          let right = position + halfWidth + shift;

          if (left < 0) {
            shift += -left;
            left = 0;
            right = position + halfWidth + shift;
          }

          if (right > timelineWidth) {
            shift -= right - timelineWidth;
            right = timelineWidth;
            left = position - halfWidth + shift;
          }

          if (left - previousRight < minGap) {
            label.classList.add('hide');
            return;
          }

          previousRight = right;
          label.style.setProperty('--label-shift', `${Math.round(shift)}px`);
        });
      }

      function ensureLayer(index) {
        if (!map.getSource(sourceId(index))) {
          map.addSource(sourceId(index), {
            type: 'raster',
            tiles: [snapshots[index].url],
            tileSize: 256,
            maxzoom: snapshots[index].maxzoom,
            attribution: 'City of Philadelphia / PASDA',
          });
        }

        if (!map.getLayer(layerId(index))) {
          map.addLayer({
            id: layerId(index),
            type: 'raster',
            source: sourceId(index),
            paint: {
              'raster-opacity': 0,
              'raster-opacity-transition': { duration: 500, delay: 0 },
              'raster-fade-duration': 0,
            },
          });
        }
      }

      function updateHud(animate) {
        const snapshot = snapshots[currentIndex];

        if (animate) {
          yearEl.classList.add('exit');
          setTimeout(() => {
            yearEl.textContent = String(snapshot.year);
            yearEl.classList.remove('exit');
          }, 160);
        } else {
          yearEl.textContent = String(snapshot.year);
        }

        labelEl.textContent = snapshot.label;
        badgeEl.textContent = snapshot.era;
        badgeEl.style.color = eraColors[snapshot.era] ?? '#fff';
        warnEl.classList.toggle('show', snapshot.gaps === true);
        trackFillEl.style.width = pct(snapshot.year);

        document.querySelectorAll('.tick').forEach((element, index) => {
          element.classList.toggle('active', index === currentIndex);
        });
      }

      function showYear(index, animate = true) {
        if (index < 0 || index >= snapshots.length) {
          return;
        }

        const duration = animate ? 500 : 0;
        const start = Math.max(0, index - prefetchWindow);
        const end = Math.min(snapshots.length - 1, index + prefetchWindow);

        for (let candidate = start; candidate <= end; candidate += 1) {
          ensureLayer(candidate);
        }

        requestAnimationFrame(() => {
          for (let candidate = start; candidate <= end; candidate += 1) {
            if (!map.getLayer(layerId(candidate))) {
              continue;
            }

            map.setPaintProperty(layerId(candidate), 'raster-opacity-transition', { duration, delay: 0 });
            map.setPaintProperty(layerId(candidate), 'raster-opacity', candidate === index ? 1 : 0);
          }
        });

        setTimeout(() => {
          for (let candidate = 0; candidate < snapshots.length; candidate += 1) {
            if (candidate >= start && candidate <= end) {
              continue;
            }

            if (map.getLayer(layerId(candidate))) {
              map.removeLayer(layerId(candidate));
            }

            if (map.getSource(sourceId(candidate))) {
              map.removeSource(sourceId(candidate));
            }
          }
        }, duration + 100);

        currentIndex = index;
        updateHud(animate);
      }

      function stopPlay() {
        if (!playing) {
          return;
        }

        playing = false;
        clearInterval(playTimer);
        playTimer = null;
        playBtn.textContent = '>';
        playBtn.title = 'Play (Space)';
      }

      function startPlay() {
        playing = true;
        playBtn.textContent = '||';
        playBtn.title = 'Pause (Space)';

        if (currentIndex >= snapshots.length - 1) {
          showYear(0, false);
        }

        playTimer = setInterval(() => {
          if (currentIndex >= snapshots.length - 1) {
            stopPlay();
            return;
          }

          showYear(currentIndex + 1);
        }, playSpeed);
      }

      snapshots.forEach((snapshot, index) => {
        const tick = document.createElement('div');
        tick.className = index === currentIndex ? 'tick active' : 'tick';
        tick.style.left = pct(snapshot.year);
        tick.title = `${snapshot.year} - ${snapshot.label}`;

        const dot = document.createElement('div');
        dot.className = 'dot';

        const label = document.createElement('div');
        label.className = 'tick-lbl';
        label.textContent = String(snapshot.year);

        tick.append(dot, label);
        tick.addEventListener('click', () => {
          dismissIntro();
          stopPlay();
          showYear(index);
        });

        timelineEl.appendChild(tick);
        labelEntries.push({ label, year: snapshot.year });
      });

      const eraRow = document.getElementById('era-row');
      [
        { label: 'City Atlas', year: 1885 },
        { label: 'Early Aerial', year: 1953 },
        { label: 'Modern Aerial Photography', year: 2011 },
      ].forEach(({ label, year }) => {
        const element = document.createElement('div');
        element.className = 'era-tag';
        element.style.left = pct(year);
        element.textContent = label;
        eraRow.appendChild(element);
      });

      playBtn.addEventListener('click', () => {
        dismissIntro();
        if (playing) {
          stopPlay();
        } else {
          startPlay();
        }
      });

      jumpStartBtn.addEventListener('click', () => {
        dismissIntro();
        stopPlay();
        showYear(0);
      });

      helpToggleBtn?.addEventListener('click', () => {
        setHelpOpen(!helpPanelEl?.classList.contains('is-open'));
      });

      helpCloseBtn?.addEventListener('click', () => {
        setHelpOpen(false);
      });

      document.querySelectorAll('.speed-btn').forEach((button) => {
        button.addEventListener('click', () => {
          document.querySelectorAll('.speed-btn').forEach((candidate) => {
            candidate.classList.remove('active');
          });

          button.classList.add('active');
          playSpeed = Number.parseInt(button.dataset.speed ?? '1400', 10);

          if (playing) {
            stopPlay();
            startPlay();
          }
        });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          dismissIntro();
          stopPlay();
          showYear(currentIndex + 1);
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          dismissIntro();
          stopPlay();
          showYear(currentIndex - 1);
        } else if (event.key === ' ') {
          event.preventDefault();
          dismissIntro();

          if (playing) {
            stopPlay();
          } else {
            startPlay();
          }
        } else if (event.key === 'Home') {
          event.preventDefault();
          dismissIntro();
          stopPlay();
          showYear(0);
        } else if (event.key === 'End') {
          event.preventDefault();
          dismissIntro();
          stopPlay();
          showYear(snapshots.length - 1);
        } else if (event.key === 'Escape') {
          setHelpOpen(false);
        }
      });

      map.on('load', () => {
        showYear(currentIndex, false);
      });

      layoutTimelineLabels();
      window.addEventListener('resize', layoutTimelineLabels);
    </script>
  </body>
</html>
