---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wordmark from '../components/Wordmark.astro';
import Install from '../components/Install.astro';
import catalog from '../data/catalog.generated.json';
const base = import.meta.env.BASE_URL;
---
<BaseLayout>
  <section class="hero">
    <p class="eyebrow">Open data. Philadelphia.</p>
    <div class="wordmark"><Wordmark /></div>
    <h1>Your city.<br />A little more legible.</h1>
    <p class="lede">{catalog.datasets} public datasets, one small toolkit.<br class="desktop" /> Find the data. Ask a question. Make something useful.</p>
    <div class="facts"><span>CLI + Python + MCP</span><span>Open source / MIT</span></div>
  </section>
  <section id="install">
    <div class="section-head"><h2>Start here.</h2><span class="eyebrow">01 / Install</span></div>
    <Install />
  </section>
  <section>
    <div class="section-head"><h2>A question is a good beginning.</h2><span class="eyebrow">02 / Ask</span></div>
    <ul class="questions"><li>“Find building permit datasets.”</li><li>“Show the fields in crime incidents.”</li><li>“Count matching records by category.”</li></ul>
    <p class="muted">Connect an MCP client to search, inspect and query data with source links attached. Bounded remote queries are available for {catalog.queryableDatasets} datasets; every resource tells you what it supports.</p>
    <a href={`${base}connect/`}>Connect your tools →</a>
    <p class="status">Local setup is ready. A hosted endpoint is not live yet.</p>
  </section>
  <section>
    <div class="section-head"><h2>See what people can build.</h2><span class="eyebrow">03 / Explore</span></div>
    <a class="atlas" href={`${base}explorations/city-atlas/`}><span class="atlas-grid" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span><span><strong>City Atlas</strong><br /><span class="muted">Philadelphia, 1860 → today</span></span><span aria-hidden="true">↗</span></a>
    <p><a href={`${base}explorations/`}>All explorations →</a></p>
  </section>
</BaseLayout>
<style>
  .hero { padding:20px 0 8px; } .hero .eyebrow { margin-bottom:32px; } .wordmark { width: min(390px,90%); color:var(--fg); } .wordmark :global(svg) { display:block; width:100%; height:auto; }
  h1 { margin-top:34px; margin-bottom:20px; } .lede { font-size:15px; } .facts { display:flex; gap:22px; flex-wrap:wrap; font-size:10px; color:var(--green); margin-top:26px; }
  .section-head { display:flex; align-items:baseline; justify-content:space-between; gap:20px; } .section-head h2 { margin:0; } .section-head .eyebrow { flex-shrink:0; font-size:10px; }
  .questions { list-style:none; padding:0; margin:26px 0; } .questions li { padding:9px 0; font-size:13px; } .questions li::before { content:'↳ '; color:var(--green); }
  .status { font-size:11px; color:var(--muted); } .atlas { margin-top:26px; display:flex; align-items:center; gap:20px; padding:20px; border:1px solid var(--line); text-decoration:none; color:var(--fg); } .atlas>span:last-child { margin-left:auto; color:var(--green); } .atlas strong { font-weight:500; } .atlas .muted { font-size:11px; }
  .atlas-grid { display:grid; grid-template-columns:repeat(3,10px); gap:3px; transform:rotate(-12deg); } .atlas-grid i { width:10px; height:15px; background:var(--green); opacity:.75; } .atlas-grid i:nth-child(3n) { opacity:.35; }
  @media(max-width:480px) { .section-head { display:block; } .section-head .eyebrow { display:block; margin-top:10px; } .desktop { display:none; } }
</style>
